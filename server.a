@app.get("/api/health")
def health():
    return {
        "status": "online",
        "ecosystem": "VidyāSetu (विद्या-सेतु)",
        "proposal": "Code Kernel '26 Decode Round",
        "compliance": "DPDP Act (2023) Verified"
    }

@app.get("/api/dag/graph")
def get_dag_graph():
    """Returns the multi-year Reverse Prerequisite Knowledge Graph"""
    return {
        "graph_type": "Directed Acyclic Knowledge Graph (DAG)",
        "nodes": TOPICS_DAG,
        "root_prerequisite": "C6_FRAC",
        "board_target": "C10_QUAD"
    }

@app.post("/api/dag/reverse-traverse")
def reverse_traverse(req: ReverseTraversalRequest):
    """Traverses backward along prerequisite edges to isolate multi-grade gaps"""
    target = req.target_topic_id
    if target not in TOPICS_DAG:
        raise HTTPException(status_code=404, detail="Topic ID not in DAG.")
    
    path = []
    curr = target
    while curr:
        node = TOPICS_DAG[curr]
        path.append({
            "topic_id": node["topic_id"],
            "grade": node["grade"],
            "name": node["name"],
            "ncert_mapping": node["ncert_mapping"]
        })
        curr = node["prerequisite_ids"][0] if node["prerequisite_ids"] else None

    return {
        "target_topic": target,
        "backward_prerequisite_chain": path,
        "remediation_suggestion": "Class 7 Integer Sign Transposition recap before proceeding."
    }

@app.post("/api/student/exit-ticket-evaluate")
def evaluate_exit_ticket(sub: ExitTicketSubmission):
    """Evaluates 3-question daily exit ticket with Confidence Calibration"""
    results = []
    lucky_guesses = 0
    active_misconceptions = 0
    firm_mastery = 0

    student = next((s for s in STUDENTS_DB if s["id"] == sub.student_id), None)
    prior = student["mastery_prob"] if student else 0.50

    for item in sub.items:
        q = next((q for q in QUESTIONS_DB if q["question_id"] == item.question_id), None)
        if not q:
            continue
        
        is_correct = (item.selected_option.strip() == q["correct_answer"].strip())
        prior = calculate_bkt_step(prior, is_correct)

        # Confidence Matrix Classification
        classification = "Normal"
        if is_correct and item.confidence == "low":
            classification = "Lucky Guess (Requires subtle reinforcement)"
            lucky_guesses += 1
        elif not is_correct and item.confidence == "high":
            classification = "Active Misconception (Urgent unlearning required)"
            active_misconceptions += 1
        elif is_correct and item.confidence in ["high", "med"]:
            classification = "Firm Mastery"
            firm_mastery += 1

        results.append({
            "question_id": item.question_id,
            "is_correct": is_correct,
            "confidence": item.confidence,
            "classification": classification
        })

    return {
        "student_id": sub.student_id,
        "updated_mastery_probability": prior,
        "results": results,
        "summary": {
            "firm_mastery": firm_mastery,
            "lucky_guesses": lucky_guesses,
            "active_misconceptions": active_misconceptions
        }
    }

@app.get("/api/teacher/rule-of-three")
def get_rule_of_three_action_clusters():
    """Generates the 'Rule of 3' Daily Action Clusters & Auto-Scripted Blackboard Lesson"""
    sprint_students = [s["name"] for s in STUDENTS_DB if s["mastery_prob"] >= 0.85]
    guided_students = [s["name"] for s in STUDENTS_DB if 0.60 <= s["mastery_prob"] < 0.85]
    bridge_students = [s["name"] for s in STUDENTS_DB if s["mastery_prob"] < 0.60]

    return {
        "class": "Class 8-B",
        "topic": "Linear Equations in One Variable (NCERT Ch 2)",
        "cohorts": {
            "sprint": {
                "name": "Cohort Sprint (15%)",
                "percentage": "15%",
                "count": len(sprint_students),
                "students": sprint_students,
                "pedagogical_action": "Assigned Olympiad / higher-order bracket challenge worksheets."
            },
            "guided": {
                "name": "Cohort Guided (60%)",
                "percentage": "60%",
                "count": len(guided_students),
                "students": guided_students,
                "pedagogical_action": "Assigned standard textbook board practice."
            },
            "bridge": {
                "name": "Cohort Bridge (25%)",
                "percentage": "25%",
                "count": len(bridge_students),
                "students": bridge_students,
                "shared_gap": "Class 7 Integer Sign Transposition",
                "pedagogical_action": "Assigned 3-minute opening blackboard recap."
            }
        },
        "auto_scripted_blackboard_lesson": {
            "title": "3-Minute Opening Blackboard Script (Tomorrow's First 5 Minutes)",
            "duration": "3 minutes",
            "verbatim_script": "Draw two weighing scale pans on the chalkboard. On the left pan, place an unknown box 'x' and 3 chalk sticks. On the right, place 11 chalk sticks. Turn to the back bench: 'If we take 3 chalks from the left, how many must we remove from the right to keep it flat?' Once they answer 8, divide into halves to reveal x = 4.",
            "board_diagram": "Pan Left: [ x ] + [ 3 ]  <==== Flat Beam ====>  Pan Right: [ 11 ]"
        }
    }

@app.post("/api/zerodevice/scan-batch")
def simulate_optical_scan(batch: OpticalScanBatch):
    """Simulates zero-device mobile camera scanning of 50 pre-printed paper exit slips in under 60s"""
    return {
        "class_id": batch.class_id,
        "sheets_scanned": batch.scanned_sheets_count,
        "time_elapsed_seconds": 42.4,
        "optical_accuracy": "99.4%",
        "status": "Successfully digitized 50 exit slips into Teacher Co-Pilot!",
        "identified_gaps": [
            "10 students in Cohort Bridge have Class 7 integer sign misconceptions."
        ]
    }

