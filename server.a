# ---------------------------------------------------------------------------
# Pydantic Schemas
# ---------------------------------------------------------------------------

class ConfidenceAssessmentItem(BaseModel):
    question_id: str
    selected_option: str
    confidence: str # 'low', 'med', 'high'

class ExitTicketSubmission(BaseModel):
    student_id: int
    items: List[ConfidenceAssessmentItem]

class ReverseTraversalRequest(BaseModel):
    target_topic_id: str = "C8_LINEAR"

class OpticalScanBatch(BaseModel):
    class_id: str = "8-B"
    scanned_sheets_count: int = 50

# ---------------------------------------------------------------------------
# Algorithmic Logic: BKT + Confidence Matrix Calibration
# ---------------------------------------------------------------------------

def calculate_bkt_step(prior: float, is_correct: bool, p_transit: float = 0.15, p_slip: float = 0.10, p_guess: float = 0.20) -> float:
    if is_correct:
        num = prior * (1.0 - p_slip)
        den = num + ((1.0 - prior) * p_guess)
    else:
        num = prior * p_slip
        den = num + ((1.0 - prior) * (1.0 - p_guess))
    post = num / den if den > 0 else prior
    return round(min(max(post + ((1.0 - post) * p_transit), 0.05), 0.99), 3)

