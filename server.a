    description="A Teacher-Centric Adaptive Learning & Foundational Diagnostic Ecosystem for Classes 6 to 10",
    version="2.0.0"
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

